{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/lang-gui/registry.schema.json",
  "title": "Material Designer every-element Material Design registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "evidencePolicy", "ownerInventoryFile", "ownerInventorySchemaFile", "desktopClassificationFile", "siteClassificationFile", "requiredSurfaceIds", "requiredElementIds", "requiredStateIds", "requiredFieldIds", "surfaces", "elements"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 2},
    "evidencePolicy": {"const": "fail-closed-real-source-and-built-artifact"},
    "ownerInventoryFile": {"const": ".codex/verification/lang-gui/source-owners.json"},
    "ownerInventorySchemaFile": {"const": ".codex/verification/lang-gui/source-owners.schema.json"},
    "desktopClassificationFile": {"const": ".codex/verification/lang-gui/desktop-elements.json"},
    "siteClassificationFile": {"const": ".codex/verification/lang-gui/site-elements.json"},
    "requiredSurfaceIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "requiredElementIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "requiredStateIds": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"enum": ["normal", "hover", "focus", "pressed", "selected", "disabled", "dragged", "validation", "loading", "success", "warning", "error"]}},
    "requiredFieldIds": {"type": "array", "minItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "surfaces": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/surface"}},
    "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stateValue": {"enum": ["partial", "unverified", "verified", "not-applicable"]},
    "proofStatus": {"enum": ["unrun", "partial", "unverified", "verified", "not-applicable"]},
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["path", "anchor", "kind", "ownerToken", "sourceHash"],
      "properties": {"path": {"type": "string", "minLength": 1}, "anchor": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "ownerToken": {"type": "string", "minLength": 1}, "sourceHash": {"$ref": "#/$defs/hash"}}
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["state", "reason"],
      "properties": {"state": {"$ref": "#/$defs/stateValue"}, "reason": {"type": "string", "minLength": 1}}
    },
    "surface": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "route", "sourceLineage", "elementIds", "status"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["desktop-application", "documentation-site"]}, "route": {"type": "string", "minLength": 1}, "sourceLineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineage"}}, "elementIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "status": {"$ref": "#/$defs/status"}}
    },
    "states": {
      "type": "object", "additionalProperties": false, "required": ["normal", "hover", "focus", "pressed", "selected", "disabled", "dragged", "validation", "loading", "success", "warning", "error"],
      "properties": {"normal": {"$ref": "#/$defs/stateValue"}, "hover": {"$ref": "#/$defs/stateValue"}, "focus": {"$ref": "#/$defs/stateValue"}, "pressed": {"$ref": "#/$defs/stateValue"}, "selected": {"$ref": "#/$defs/stateValue"}, "disabled": {"$ref": "#/$defs/stateValue"}, "dragged": {"$ref": "#/$defs/stateValue"}, "validation": {"$ref": "#/$defs/stateValue"}, "loading": {"$ref": "#/$defs/stateValue"}, "success": {"$ref": "#/$defs/stateValue"}, "warning": {"$ref": "#/$defs/stateValue"}, "error": {"$ref": "#/$defs/stateValue"}}
    },
    "stringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rolesNamesActions": {
      "type": "object", "additionalProperties": false, "required": ["roles", "accessibleNames", "actions", "keyboard", "touch"],
      "properties": {"roles": {"$ref": "#/$defs/stringList"}, "accessibleNames": {"$ref": "#/$defs/stringList"}, "actions": {"$ref": "#/$defs/stringList"}, "keyboard": {"$ref": "#/$defs/stringList"}, "touch": {"$ref": "#/$defs/stringList"}}
    },
    "semantic": {
      "type": "object", "additionalProperties": false, "required": ["role", "accessibleName", "actions"],
      "properties": {"role": {"type": "string", "minLength": 1}, "accessibleName": {"type": "string", "minLength": 1}, "actions": {"$ref": "#/$defs/stringList"}}
    },
    "material": {
      "type": "object", "additionalProperties": false, "required": ["primitive", "anatomy"],
      "properties": {"primitive": {"type": "string", "minLength": 1}, "anatomy": {"$ref": "#/$defs/stringList"}}
    },
    "roleStatus": {
      "type": "object", "additionalProperties": false, "required": ["roles", "status"],
      "properties": {"roles": {"$ref": "#/$defs/stringList"}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "levelStatus": {
      "type": "object", "additionalProperties": false, "required": ["levels", "status"],
      "properties": {"levels": {"$ref": "#/$defs/stringList"}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "stateLayerStatus": {
      "type": "object", "additionalProperties": false, "required": ["states", "status"],
      "properties": {"states": {"$ref": "#/$defs/stringList"}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "motion": {
      "type": "object", "additionalProperties": false, "required": ["policy", "status"],
      "properties": {"policy": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "focus": {
      "type": "object", "additionalProperties": false, "required": ["keyboard", "visible", "return", "status"],
      "properties": {"keyboard": {"type": "string", "minLength": 1}, "visible": {"type": "boolean"}, "return": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "targetSize": {
      "type": "object", "additionalProperties": false, "required": ["minimumCssPx", "status"],
      "properties": {"minimumCssPx": {"type": "number", "minimum": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "contrast": {
      "type": "object", "additionalProperties": false, "required": ["foreground", "background", "ratio", "status"],
      "properties": {"foreground": {"type": "string", "minLength": 1}, "background": {"type": "string", "minLength": 1}, "ratio": {"type": ["number", "null"]}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "responsiveTuple": {
      "type": "object", "additionalProperties": false, "required": ["viewport", "scale", "theme", "status"],
      "properties": {"viewport": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"}, "scale": {"type": "number", "minimum": 0.1}, "theme": {"enum": ["light", "dark"]}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "contextMenu": {
      "type": "object", "additionalProperties": false, "required": ["route", "actions", "search", "status"],
      "properties": {"route": {"type": "string", "minLength": 1}, "actions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "search": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "appearanceEditor": {
      "type": "object", "additionalProperties": false, "required": ["route", "properties", "status"],
      "properties": {"route": {"type": "string", "minLength": 1}, "properties": {"$ref": "#/$defs/stringList"}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "lockRoute": {
      "type": "object", "additionalProperties": false, "required": ["route", "policies", "status"],
      "properties": {"route": {"type": "string", "minLength": 1}, "policies": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "searchRegexRoute": {
      "type": "object", "additionalProperties": false, "required": ["route", "mode", "builder", "status"],
      "properties": {"route": {"type": "string", "minLength": 1}, "mode": {"type": "string", "minLength": 1}, "builder": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "localization": {
      "type": "object", "additionalProperties": false, "required": ["modes", "status"],
      "properties": {"modes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "persistence": {
      "type": "object", "additionalProperties": false, "required": ["storage", "fields", "status"],
      "properties": {"storage": {"type": "string", "minLength": 1}, "fields": {"$ref": "#/$defs/stringList"}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "test": {
      "type": "object", "additionalProperties": false, "required": ["focused", "command", "status"],
      "properties": {"focused": {"$ref": "#/$defs/stringList"}, "command": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "negativeProof": {
      "type": "object", "additionalProperties": false, "required": ["guard", "scenario", "redThenGreen", "status"],
      "properties": {"guard": {"type": "string", "minLength": 1}, "scenario": {"type": "string", "minLength": 1}, "redThenGreen": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/proofStatus"}}
    },
    "interactionReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "path", "artifactPath", "sourceCommit", "artifactSourceCommit", "artifactHash", "artifactGitBlob", "receiptHash", "receiptGitBlob", "privacy"],
      "properties": {
        "status": {"$ref": "#/$defs/proofStatus"}, "path": {"type": ["string", "null"]}, "artifactPath": {"type": ["string", "null"]}, "sourceCommit": {"type": "string", "minLength": 1}, "artifactSourceCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "artifactHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "artifactGitBlob": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "receiptHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "receiptGitBlob": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "privacy": {"enum": ["not-captured", "pass", "fail"]}
      }
    },
    "captureTuple": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "route", "state", "viewport", "scale", "theme", "path", "captureHash", "captureGitBlob", "artifactHash", "mediaType", "width", "height", "privacy", "contrast"],
      "properties": {
        "status": {"$ref": "#/$defs/proofStatus"}, "route": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}, "viewport": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"}, "scale": {"type": "number", "minimum": 0.1}, "theme": {"enum": ["light", "dark"]}, "path": {"type": ["string", "null"]}, "captureHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "captureGitBlob": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "artifactHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "mediaType": {"enum": ["image/png", "unverified"]}, "width": {"type": ["integer", "null"], "minimum": 1}, "height": {"type": ["integer", "null"], "minimum": 1}, "privacy": {"enum": ["not-reviewed", "pass", "fail"]}, "contrast": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "receiptDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "extensionNamespace", "elementId", "sourceCommit", "artifact", "capture", "tuple", "interaction", "privacy", "contrast"],
      "properties": {
        "schema": {"const": "material-designer.lang-gui.interaction-receipt"}, "version": {"const": 1},
        "extensionNamespace": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "material-designer.lang-gui.interaction-receipt.extensions"}, "version": {"const": 1}}},
        "elementId": {"$ref": "#/$defs/id"}, "sourceCommit": {"$ref": "#/$defs/gitObject"},
        "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "gitBlob"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "gitBlob": {"$ref": "#/$defs/gitObject"}}},
        "capture": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "gitBlob", "mediaType", "width", "height"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "gitBlob": {"$ref": "#/$defs/gitObject"}, "mediaType": {"const": "image/png"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
        "tuple": {"type": "object", "additionalProperties": false, "required": ["route", "state", "theme", "viewport", "scale"], "properties": {"route": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}, "theme": {"enum": ["light", "dark"]}, "viewport": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"}, "scale": {"type": "number", "minimum": 0.1}}},
        "interaction": {"type": "object", "additionalProperties": false, "required": ["action", "target", "before", "after"], "properties": {"action": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "before": {"type": "string", "minLength": 1}, "after": {"type": "string", "minLength": 1}}},
        "privacy": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "pass"}, "reason": {"type": "string", "minLength": 1}}},
        "contrast": {"type": "object", "additionalProperties": false, "required": ["status", "ratio", "foreground", "background"], "properties": {"status": {"const": "verified"}, "ratio": {"type": "number", "minimum": 4.5}, "foreground": {"type": "string", "minLength": 1}, "background": {"type": "string", "minLength": 1}}}
      }
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["stableElementId", "owner", "route", "sourceLineage", "rolesNamesActions", "semantic", "states", "material", "colors", "typography", "shape", "elevation", "stateLayers", "motion", "density", "focus", "targetSize", "contrast", "responsiveMatrix", "contextMenu", "appearanceEditor", "lockRoute", "searchRegexRoute", "localization", "persistence", "test", "negativeProof", "interactionReceipt", "captureTuple", "status"],
      "properties": {
        "stableElementId": {"$ref": "#/$defs/id"}, "owner": {"type": "string", "minLength": 1}, "route": {"type": "string", "minLength": 1}, "sourceLineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineage"}}, "rolesNamesActions": {"$ref": "#/$defs/rolesNamesActions"}, "semantic": {"$ref": "#/$defs/semantic"}, "states": {"$ref": "#/$defs/states"}, "material": {"$ref": "#/$defs/material"}, "colors": {"$ref": "#/$defs/roleStatus"}, "typography": {"$ref": "#/$defs/roleStatus"}, "shape": {"$ref": "#/$defs/roleStatus"}, "elevation": {"$ref": "#/$defs/levelStatus"}, "stateLayers": {"$ref": "#/$defs/stateLayerStatus"}, "motion": {"$ref": "#/$defs/motion"}, "density": {"$ref": "#/$defs/levelStatus"}, "focus": {"$ref": "#/$defs/focus"}, "targetSize": {"$ref": "#/$defs/targetSize"}, "contrast": {"$ref": "#/$defs/contrast"}, "responsiveMatrix": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/responsiveTuple"}}, "contextMenu": {"$ref": "#/$defs/contextMenu"}, "appearanceEditor": {"$ref": "#/$defs/appearanceEditor"}, "lockRoute": {"$ref": "#/$defs/lockRoute"}, "searchRegexRoute": {"$ref": "#/$defs/searchRegexRoute"}, "localization": {"$ref": "#/$defs/localization"}, "persistence": {"$ref": "#/$defs/persistence"}, "test": {"$ref": "#/$defs/test"}, "negativeProof": {"$ref": "#/$defs/negativeProof"}, "interactionReceipt": {"$ref": "#/$defs/interactionReceipt"}, "captureTuple": {"$ref": "#/$defs/captureTuple"}, "status": {"$ref": "#/$defs/status"}
      }
    }
  }
}
