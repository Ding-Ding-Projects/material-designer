{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature lineage inventory",
  "type": "object",
  "required": ["schemaVersion", "inventoryId", "target", "canonicalFeatureIds", "lineageCommits", "mainCustomFeatures", "linkedWorktreeCommits", "preservationBranches", "surfaces", "counts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "inventoryId": { "const": "feature-lineage-v1" },
    "target": { "$ref": "#/$defs/target" },
    "canonicalFeatureIds": { "type": "array", "const": ["language-modes", "dialog-emoji-toggle", "school-mode", "narration", "scheduled-settings", "dim-sum-surprise", "regex-builders", "notification-centre", "appearance-editors", "tabbed-navigation", "offline-documentation", "command-palette", "destructive-confirmation", "local-history", "changelog-viewer", "external-editor", "exports", "bulk-actions", "accessibility-responsive-sizing", "personal-vocabulary-upload", "toy-locks-authentication", "unlock-ladder", "shared-link-embed", "adhd-modes", "browser-download-surfaces", "app-logo-customization", "file-converter", "ollama-suite-manager", "status-hub", "front-screen-provenance"] },
    "lineageCommits": { "type": "array", "minItems": 98, "maxItems": 98, "items": { "$ref": "#/$defs/lineageCommit" } },
    "mainCustomFeatures": { "type": "array", "minItems": 30, "maxItems": 30, "items": { "$ref": "#/$defs/feature" } },
    "linkedWorktreeCommits": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/linkedCommit" } },
    "preservationBranches": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "$ref": "#/$defs/preservation" } },
    "surfaces": { "type": "array", "minItems": 60, "maxItems": 60, "items": { "$ref": "#/$defs/surface" } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["upstreamCommits", "mainCustomFeatures", "linkedWorktreeCommits", "preservationBranches", "surfaces", "surfacesPerFeature"], "properties": { "upstreamCommits": { "const": 98 }, "mainCustomFeatures": { "const": 30 }, "linkedWorktreeCommits": { "const": 13 }, "preservationBranches": { "const": 22 }, "surfaces": { "const": 60 }, "surfacesPerFeature": { "const": 2 } } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "text": { "type": "string", "minLength": 1 },
    "target": { "type": "object", "additionalProperties": false, "required": ["sourceRepository", "sourceUrl", "pinnedImport", "targetCommit", "expectedCommitCount", "membershipOrder"], "properties": { "sourceRepository": { "const": "nexu-io/open-design" }, "sourceUrl": { "const": "https://github.com/nexu-io/open-design.git" }, "pinnedImport": { "$ref": "#/$defs/sha" }, "targetCommit": { "$ref": "#/$defs/sha" }, "expectedCommitCount": { "const": 98 }, "membershipOrder": { "const": "git log -n 98 <target>" } } },
    "lineageCommit": { "type": "object", "additionalProperties": false, "required": ["order", "sha", "subject"], "properties": { "order": { "type": "integer", "minimum": 1, "maximum": 98 }, "sha": { "$ref": "#/$defs/sha" }, "subject": { "$ref": "#/$defs/text" } } },
    "linkedCommit": { "type": "object", "additionalProperties": false, "required": ["branch", "sha", "subject", "subjectMode"], "properties": { "branch": { "$ref": "#/$defs/text" }, "sha": { "$ref": "#/$defs/sha" }, "subject": { "$ref": "#/$defs/text" }, "subjectMode": { "enum": ["git-first-line", "literal-escape-first-line-public"] } } },
    "preservation": { "type": "object", "additionalProperties": false, "required": ["branch", "sha", "subject"], "properties": { "branch": { "pattern": "^preservation/[a-z0-9-]+$" }, "sha": { "$ref": "#/$defs/sha" }, "subject": { "$ref": "#/$defs/text" } } },
    "implementation": { "type": "object", "additionalProperties": false, "required": ["status", "paths"], "properties": { "status": { "enum": ["implemented", "partial", "absent", "unreachable"] }, "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "feature": { "type": "object", "additionalProperties": false, "required": ["id", "lineageCommits", "behavior", "paths", "apisOrStorage", "desktopImplementation", "siteImplementation", "materialDesign3", "localization", "persistence", "tests", "negativeProof", "interactions", "captures", "state"], "properties": { "id": { "type": "string" }, "lineageCommits": { "type": "array", "items": { "$ref": "#/$defs/sha" } }, "behavior": { "$ref": "#/$defs/text" }, "paths": { "type": "array", "items": { "type": "string" } }, "apisOrStorage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "desktopImplementation": { "$ref": "#/$defs/implementation" }, "siteImplementation": { "$ref": "#/$defs/implementation" }, "materialDesign3": { "$ref": "#/$defs/text" }, "localization": { "$ref": "#/$defs/text" }, "persistence": { "$ref": "#/$defs/text" }, "tests": { "$ref": "#/$defs/text" }, "negativeProof": { "$ref": "#/$defs/text" }, "interactions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "captures": { "type": "array", "items": { "type": "string" } }, "state": { "enum": ["implemented", "partial", "absent", "unreachable"] } } },
    "surface": { "type": "object", "additionalProperties": false, "required": ["surfaceId", "featureId", "lineageCommits", "behavior", "paths", "apisOrStorage", "desktopOrSiteImplementation", "materialDesign3", "localization", "persistence", "tests", "negativeProof", "interactions", "captures", "state"], "properties": { "surfaceId": { "enum": ["windows-desktop-application", "documentation-site"] }, "featureId": { "type": "string" }, "lineageCommits": { "type": "array", "items": { "$ref": "#/$defs/sha" } }, "behavior": { "$ref": "#/$defs/text" }, "paths": { "type": "array", "items": { "type": "string" } }, "apisOrStorage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "desktopOrSiteImplementation": { "$ref": "#/$defs/implementation" }, "materialDesign3": { "$ref": "#/$defs/text" }, "localization": { "$ref": "#/$defs/text" }, "persistence": { "$ref": "#/$defs/text" }, "tests": { "$ref": "#/$defs/text" }, "negativeProof": { "$ref": "#/$defs/text" }, "interactions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "captures": { "type": "array", "items": { "type": "string" } }, "state": { "enum": ["implemented", "partial", "absent", "unreachable"] } } }
  }
}
