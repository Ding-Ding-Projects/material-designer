{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/ledger.schema.json",
  "title": "Material Designer durable append-only UI drive ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inventoryVersion", "ledgerMode", "evidencePolicy", "approvedHeadlessRoute", "rows"],
  "properties": {
    "version": { "const": 2 },
    "inventoryVersion": { "const": 1 },
    "ledgerMode": { "const": "durable-append-only-one-receipt-per-interaction" },
    "evidencePolicy": { "const": "fail-closed-real-built-artifact-only" },
    "approvedHeadlessRoute": { "const": "cheap-lowlevel-headless" },
    "rows": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiptId", "receiptPath", "receiptSha256", "sceneId", "surfaceId", "featureId", "destinationId", "interactionId", "sequence", "sourceCommit", "artifactPath", "artifactSha256", "artifactBuiltFromCommit", "artifactProvenancePath", "artifactProvenanceSha256", "captureRunPath", "captureRunSha256", "runId", "sessionId", "imagePath", "imageSha256", "everyElementAuditPath", "everyElementAuditSha256", "approvedOutputManifestPath", "approvedOutputManifestSha256", "screenId", "state", "route", "theme", "locale", "viewportWidth", "viewportHeight", "displayScale", "headlessRoute", "networkIsolationMode", "blockedExternalRequests", "allowedOrigins", "actionKind", "actionTarget", "accessibleName", "inputMethod", "expectedBefore", "expectedAfter"],
        "properties": {
          "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
          "receiptPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "receiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sceneId": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
          "surfaceId": { "enum": ["windows-desktop-application", "documentation-site"] },
          "featureId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
          "destinationId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
          "interactionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
          "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "artifactPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifactBuiltFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "artifactProvenancePath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "artifactProvenanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "captureRunPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "captureRunSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "runId": { "type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
          "sessionId": { "type": "string", "pattern": "^session-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
          "imagePath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "everyElementAuditPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "everyElementAuditSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "approvedOutputManifestPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "approvedOutputManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "screenId": { "type": "string", "minLength": 1, "maxLength": 180 },
          "state": { "type": "string", "minLength": 1, "maxLength": 180 },
          "route": { "type": "string", "minLength": 1, "maxLength": 240 },
          "theme": { "enum": ["light", "dark", "contrast"] },
          "locale": { "enum": ["en-US", "zh-HK", "bilingual"] },
          "viewportWidth": { "type": "integer", "minimum": 320, "maximum": 10000 },
          "viewportHeight": { "type": "integer", "minimum": 480, "maximum": 10000 },
          "displayScale": { "enum": [1, 1.25, 1.5, 2] },
          "headlessRoute": { "const": "cheap-lowlevel-headless" },
          "networkIsolationMode": { "const": "capture-aware-disabled-network" },
          "blockedExternalRequests": { "const": true },
          "allowedOrigins": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["loopback", "app-resource"] } },
          "actionKind": { "enum": ["click", "right-click", "keyboard", "type", "select", "upload", "drag"] },
          "actionTarget": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "accessibleName": { "type": "string", "minLength": 1, "maxLength": 240 },
          "inputMethod": { "enum": ["pointer", "keyboard", "touch", "assistive-technology"] },
          "expectedBefore": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "expectedAfter": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
