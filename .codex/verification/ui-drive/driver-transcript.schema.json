{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/driver-transcript.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "transcriptId", "runId", "sessionId", "bridgePath", "bridgeSha256", "driverExecutablePathDigest", "driverExecutableSha256", "calls"],
  "properties": {
    "version": { "const": 1 },
    "transcriptId": { "type": "string", "pattern": "^transcript-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "sessionId": { "type": "string", "pattern": "^session-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "bridgePath": { "const": "scripts/ui-drive-lowlevel-stdin-bridge.ps1" },
    "bridgeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "driverExecutablePathDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "driverExecutableSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "calls": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "tool", "requestSha256", "responseSha256", "driverExitCode", "nonceDigest"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 256 },
          "tool": { "enum": ["launch_on_headless_desktop", "list_headless_windows", "mouse_click", "win_send_keys", "win_set_control_text", "screenshot", "close_headless_desktop"] },
          "requestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "responseSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "driverExitCode": { "const": 0 },
          "nonceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
