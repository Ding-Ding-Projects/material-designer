{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/capture-run.schema.json",
  "title": "Material Designer approved capture run",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "sessionId", "generator", "captureRoute", "sourceCommit", "artifactSha256", "target", "interaction", "semanticPolls", "originalImage", "receipt"],
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "sessionId": { "type": "string", "pattern": "^session-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driverId", "scriptPath", "scriptSha256", "invocationId"],
      "properties": {
        "driverId": { "const": "approved-cheap-lowlevel-headless-driver" },
        "scriptPath": { "const": "scripts/write-approved-ui-drive-capture-run.ps1" },
        "scriptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "invocationId": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
      }
    },
    "captureRoute": { "const": "cheap-lowlevel-headless" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "processImagePath", "processImageSha256", "windowClass", "windowTitle", "windowWidth", "windowHeight"],
      "properties": {
        "processId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "processImagePath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "processImageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "windowClass": { "type": "string", "minLength": 1, "maxLength": 240 },
        "windowTitle": { "type": "string", "minLength": 1, "maxLength": 240 },
        "windowWidth": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "windowHeight": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId", "interactionId", "sequence", "kind", "target", "accessibleName", "inputMethod"],
      "properties": {
        "sceneId": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "interactionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "kind": { "enum": ["click", "right-click", "keyboard", "type", "select", "upload", "drag"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "accessibleName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputMethod": { "enum": ["pointer", "keyboard", "touch", "assistive-technology"] }
      }
    },
    "semanticPolls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "method", "elapsedMs", "observedState"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 120 },
          "method": { "type": "string", "minLength": 1, "maxLength": 120 },
          "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 120000 },
          "observedState": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "originalImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^receipt-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
