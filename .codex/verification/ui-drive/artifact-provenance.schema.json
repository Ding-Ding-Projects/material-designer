{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/artifact-provenance.schema.json",
  "title": "Material Designer captured artifact provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provenanceKind", "artifactPath", "artifactSha256", "artifactBytes", "builtFromCommit", "intendedSourceCommit", "commitPolicy", "builderId", "buildRunId"],
  "properties": {
    "version": { "const": 1 },
    "provenanceKind": { "const": "schema-validated-captured-artifact-provenance" },
    "artifactPath": { "type": "string", "minLength": 1, "maxLength": 512 },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
    "builtFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "intendedSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commitPolicy": { "const": "exact-equality-and-ancestor-of-verification-head" },
    "builderId": { "enum": ["hosted-windows-release", "supported-local-build-script"] },
    "buildRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
