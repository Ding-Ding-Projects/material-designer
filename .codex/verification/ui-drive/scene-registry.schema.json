{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/scene-registry.schema.json",
  "title": "Material Designer capture scene registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registryMode", "evidencePolicy", "approvedHeadlessRoute", "surfaces", "destinations", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "registryMode": { "const": "hand-authored-exact-scene-identities" },
    "evidencePolicy": { "const": "fail-closed-real-built-artifact-only" },
    "approvedHeadlessRoute": { "const": "cheap-lowlevel-headless" },
    "surfaces": { "type": "array", "const": ["windows-desktop-application", "documentation-site"] },
    "destinations": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "scenes": { "type": "array", "minItems": 70, "uniqueItems": true, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "networkIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "blockedExternalRequests", "allowedOrigins"],
      "properties": {
        "mode": { "const": "capture-aware-disabled-network" },
        "blockedExternalRequests": { "const": true },
        "allowedOrigins": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^(loopback|app-resource)$" } }
      }
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "state", "theme", "locale", "viewportWidth", "viewportHeight", "displayScale", "route", "headlessRoute", "networkIsolation"],
      "properties": {
        "screenId": { "type": "string", "minLength": 1, "maxLength": 180 },
        "state": { "type": "string", "minLength": 1, "maxLength": 180 },
        "theme": { "enum": ["light", "dark", "contrast"] },
        "locale": { "enum": ["en-US", "zh-HK", "bilingual"] },
        "viewportWidth": { "type": "integer", "minimum": 320, "maximum": 10000 },
        "viewportHeight": { "type": "integer", "minimum": 480, "maximum": 10000 },
        "displayScale": { "enum": [1, 1.25, 1.5, 2] },
        "route": { "type": "string", "minLength": 1, "maxLength": 240 },
        "headlessRoute": { "const": "cheap-lowlevel-headless" },
        "networkIsolation": { "$ref": "#/$defs/networkIsolation" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surfaceId", "featureId", "destinationId", "status", "statusReason", "tuple", "actionTarget", "accessibleName", "inputMethod", "expectedBefore", "expectedAfter"],
      "properties": {
        "id": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "surfaceId": { "enum": ["windows-desktop-application", "documentation-site"] },
        "featureId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "destinationId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "enum": ["unreachable", "partial", "verified"] },
        "statusReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "tuple": { "$ref": "#/$defs/tuple" },
        "actionTarget": { "type": "string", "minLength": 1, "maxLength": 240 },
        "accessibleName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputMethod": { "enum": ["pointer", "keyboard", "touch", "assistive-technology"] },
        "expectedBefore": { "type": "string", "minLength": 1, "maxLength": 500 },
        "expectedAfter": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
