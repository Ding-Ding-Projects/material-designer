{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/click-receipt.schema.json",
  "title": "Material Designer per-interaction UI evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inventoryVersion", "receiptId", "surfaceId", "featureId", "destinationId", "interactionId", "sceneId", "sequence", "sourceCommit", "artifact", "captureTuple", "action", "semanticState", "image", "captureRun", "liveOrigin", "everyElementAudit", "approvedOutputManifestPath"],
  "properties": {
    "version": { "const": 3 },
    "inventoryVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "surfaceId": { "enum": ["windows-desktop-application", "documentation-site"] },
    "featureId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "destinationId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "interactionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "sceneId": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "builtFromCommit", "kind", "provenancePath", "provenanceSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "builtFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "kind": { "const": "packaged-built-artifact" },
        "provenancePath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "provenanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "captureTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "state", "route", "theme", "locale", "viewportWidth", "viewportHeight", "displayScale", "headlessRoute", "networkIsolation"],
      "properties": {
        "screenId": { "type": "string", "minLength": 1, "maxLength": 180 },
        "state": { "type": "string", "minLength": 1, "maxLength": 180 },
        "route": { "type": "string", "minLength": 1, "maxLength": 240 },
        "theme": { "enum": ["light", "dark", "contrast"] },
        "locale": { "enum": ["en-US", "zh-HK", "bilingual"] },
        "viewportWidth": { "type": "integer", "minimum": 320, "maximum": 10000 },
        "viewportHeight": { "type": "integer", "minimum": 480, "maximum": 10000 },
        "displayScale": { "enum": [1, 1.25, 1.5, 2] },
        "headlessRoute": { "const": "cheap-lowlevel-headless" },
        "networkIsolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "blockedExternalRequests", "allowedOrigins"],
          "properties": {
            "mode": { "const": "capture-aware-disabled-network" },
            "blockedExternalRequests": { "const": true },
            "allowedOrigins": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["loopback", "app-resource"] } }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "accessibleName", "inputMethod", "outcome"],
      "properties": {
        "kind": { "enum": ["click", "right-click", "keyboard", "type", "select", "upload", "drag"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "accessibleName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputMethod": { "enum": ["pointer", "keyboard", "touch", "assistive-technology"] },
        "outcome": { "const": "completed" }
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedBefore", "observedBefore", "expectedAfter", "observedAfter", "poll", "verdict"],
      "properties": {
        "expectedBefore": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "observedBefore": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "expectedAfter": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "observedAfter": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "poll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts", "elapsedMs", "method"],
          "properties": {
            "attempts": { "type": "integer", "minimum": 1, "maximum": 120 },
            "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 120000 },
            "method": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "verdict": { "const": "matched" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "width", "height", "pixels", "format", "contentVerdict"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "pixels": { "type": "integer", "minimum": 1, "maximum": 40000000 },
        "format": { "const": "png" },
        "contentVerdict": { "const": "decoded-nonblank-no-text-metadata" }
      }
    },
    "captureRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "runId", "sessionId"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "sessionId": { "type": "string", "pattern": "^session-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 }
      }
    },
    "liveOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "originId", "verificationLevel", "pageUrl", "pageUrlDigest"],
      "properties": {
        "path": { "type": "string", "pattern": "^origins/origin-[a-z0-9]+(?:-[a-z0-9]+)*[.]json$", "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "originId": { "type": "string", "pattern": "^origin-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "verificationLevel": { "const": "live-session-only" }
        ,"pageUrl": { "type": "string", "pattern": "^(?:https?|file|app)://[^\\s]+$", "maxLength": 500 }
        ,"pageUrlDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "everyElementAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "auditId"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "auditId": { "type": "string", "pattern": "^audit-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 }
      }
    },
    "approvedOutputManifestPath": { "type": "string", "pattern": "^manifests/receipt-[a-z0-9]+(?:-[a-z0-9]+)*[.]approved-outputs[.]json$", "maxLength": 512 }
  }
}
