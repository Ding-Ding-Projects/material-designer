{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/click-receipt.schema.json",
  "title": "Material Designer per-click UI evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inventoryVersion", "receiptId", "surfaceId", "featureId", "interactionId", "sceneId", "sequence", "sourceCommit", "artifact", "captureTuple", "action", "semanticState", "image", "privacy", "inspection"],
  "properties": {
    "version": { "const": 2 },
    "inventoryVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "surfaceId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "featureId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "interactionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "sceneId": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "sequence": { "type": "integer", "minimum": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "builtFromCommit", "kind", "provenancePath"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "builtFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "kind": { "const": "packaged-built-artifact" },
        "provenancePath": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "captureTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "state", "route", "theme", "locale", "viewportWidth", "viewportHeight", "displayScale", "headlessRoute", "networkIsolation"],
      "properties": {
        "screenId": { "type": "string", "minLength": 1, "maxLength": 180 },
        "state": { "type": "string", "minLength": 1, "maxLength": 180 },
        "route": { "type": "string", "minLength": 1, "maxLength": 240 },
        "theme": { "enum": ["light", "dark", "contrast"] },
        "locale": { "enum": ["en-US", "zh-HK", "bilingual"] },
        "viewportWidth": { "type": "integer", "minimum": 320, "maximum": 10000 },
        "viewportHeight": { "type": "integer", "minimum": 480, "maximum": 10000 },
        "displayScale": { "enum": [1, 1.25, 1.5, 2] },
        "headlessRoute": { "const": "cheap-lowlevel-headless" },
        "networkIsolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "blockedExternalRequests", "allowedOrigins"],
          "properties": {
            "mode": { "const": "capture-aware-disabled-network" },
            "blockedExternalRequests": { "const": true },
            "allowedOrigins": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^(loopback|app-resource)$" } }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "accessibleName", "inputMethod", "completed"],
      "properties": {
        "kind": { "enum": ["click", "right-click", "keyboard", "type", "select", "upload", "drag"] },
        "target": { "type": "string", "minLength": 1 },
        "accessibleName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputMethod": { "enum": ["pointer", "keyboard", "touch", "assistive-technology"] },
        "completed": { "const": true }
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedBefore", "observedBefore", "expectedAfter", "observedAfter", "poll", "matched"],
      "properties": {
        "expectedBefore": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observedBefore": { "type": "string", "minLength": 1, "maxLength": 500 },
        "expectedAfter": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observedAfter": { "type": "string", "minLength": 1, "maxLength": 500 },
        "poll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "attempts", "elapsedMs", "method"],
          "properties": {
            "completed": { "const": true },
            "attempts": { "type": "integer", "minimum": 1, "maximum": 120 },
            "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 120000 },
            "method": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "matched": { "const": true }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height", "pngSignatureValid", "nonblank"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "pngSignatureValid": { "const": true },
        "nonblank": { "const": true }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "privateDataFound", "unrelatedWindowsFound"],
      "properties": {
        "checked": { "const": true },
        "privateDataFound": { "const": false },
        "unrelatedWindowsFound": { "const": false }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalOpened", "semanticStateConfirmed", "clippingChecked", "visualDefectIds", "originalImage", "everyElementAuditPath"],
      "properties": {
        "originalOpened": { "const": true },
        "semanticStateConfirmed": { "const": true },
        "clippingChecked": { "const": true },
        "visualDefectIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
        "originalImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "sha256", "pngSignatureValid", "nonblank"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "pngSignatureValid": { "const": true },
            "nonblank": { "const": true }
          }
        },
        "everyElementAuditPath": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
