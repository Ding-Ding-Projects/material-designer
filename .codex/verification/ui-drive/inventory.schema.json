{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/inventory.schema.json",
  "title": "Material Designer UI drive inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidencePolicy", "requiredFeatureIds", "requiredDestinationIds", "surfaces"],
  "properties": {
    "version": { "const": 1 },
    "evidencePolicy": { "const": "fail-closed-real-built-artifact-only" },
    "requiredFeatureIds": { "type": "array", "minItems": 30, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 } },
    "requiredDestinationIds": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 } },
    "surfaces": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 180 },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "networkIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "blockedExternalRequests", "allowedOrigins"],
      "properties": {
        "mode": { "const": "capture-aware-disabled-network" },
        "blockedExternalRequests": { "const": true },
        "allowedOrigins": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["loopback", "app-resource"] } }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "statusReason", "destinations", "features"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["desktop-application", "documentation-site"] },
        "status": { "enum": ["unreachable", "partial", "verified"] },
        "statusReason": { "$ref": "#/$defs/boundedText" },
        "destinations": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/destination" } },
        "features": { "type": "array", "minItems": 30, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "statusReason", "requiredInteractionIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["unreachable", "partial", "verified"] },
        "statusReason": { "$ref": "#/$defs/boundedText" },
        "requiredInteractionIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "statusReason", "implementationPath", "documentationPath", "requiredInteractions", "evidenceReceipts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["absent", "unreachable", "partial", "verified"] },
        "statusReason": { "$ref": "#/$defs/boundedText" },
        "implementationPath": { "type": ["string", "null"], "maxLength": 512 },
        "documentationPath": { "type": ["string", "null"], "maxLength": 512 },
        "requiredInteractions": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/interaction" } },
        "evidenceReceipts": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^receipts/receipt-[a-z0-9]+(?:-[a-z0-9]+)*[.]json$", "maxLength": 512 } }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target", "accessibleName", "inputMethod", "sceneId", "networkIsolation", "expectedBefore", "expectedAfter", "postClickCaptureRequired"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "action": { "enum": ["click", "right-click", "keyboard", "type", "select", "upload", "drag"] },
        "target": { "$ref": "#/$defs/boundedText" },
        "accessibleName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputMethod": { "enum": ["pointer", "keyboard", "touch", "assistive-technology"] },
        "sceneId": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
        "networkIsolation": { "$ref": "#/$defs/networkIsolation" },
        "expectedBefore": { "$ref": "#/$defs/boundedText" },
        "expectedAfter": { "$ref": "#/$defs/boundedText" },
        "postClickCaptureRequired": { "const": true }
      }
    }
  }
}
