{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/inventory.schema.json",
  "title": "Material Designer UI drive inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidencePolicy", "requiredFeatureIds", "requiredDestinationIds", "surfaces"],
  "properties": {
    "version": { "const": 1 },
    "evidencePolicy": { "const": "fail-closed-real-built-artifact-only" },
    "requiredFeatureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "requiredDestinationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "statusReason", "destinations", "features"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["desktop-application", "documentation-site"] },
        "status": { "enum": ["unreachable", "partial", "verified"] },
        "statusReason": { "type": "string", "minLength": 1 },
        "destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "statusReason", "requiredInteractionIds"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["unreachable", "partial", "verified"] },
        "statusReason": { "type": "string", "minLength": 1 },
        "requiredInteractionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "statusReason", "implementationPath", "documentationPath", "requiredInteractions", "evidenceReceipts"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["absent", "unreachable", "partial", "verified"] },
        "statusReason": { "type": "string", "minLength": 1 },
        "implementationPath": { "type": ["string", "null"] },
        "documentationPath": { "type": ["string", "null"] },
        "requiredInteractions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interaction" }
        },
        "evidenceReceipts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target", "expectedBefore", "expectedAfter", "postClickCaptureRequired"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "action": { "enum": ["click", "right-click", "keyboard", "type", "select", "upload", "drag"] },
        "target": { "type": "string", "minLength": 1 },
        "expectedBefore": { "type": "string", "minLength": 1 },
        "expectedAfter": { "type": "string", "minLength": 1 },
        "postClickCaptureRequired": { "const": true }
      }
    }
  }
}
