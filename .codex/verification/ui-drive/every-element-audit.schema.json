{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/material-designer/ui-drive/every-element-audit.schema.json",
  "title": "Material Designer every-element UI audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "auditId", "surfaceId", "sceneId", "sourceCommit", "artifactSha256", "runId", "coverageMode", "requiredElementCount", "auditedElementCount", "missingElementIds", "elements", "visualInspection"],
  "properties": {
    "version": { "const": 1 },
    "auditId": { "type": "string", "pattern": "^audit-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "surfaceId": { "enum": ["windows-desktop-application", "documentation-site"] },
    "sceneId": { "type": "string", "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 180 },
    "coverageMode": { "const": "hand-written-every-rendered-element" },
    "requiredElementCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "auditedElementCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "missingElementIds": { "type": "array", "const": [] },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elementId", "status", "contextMenuRoute", "appearanceRoute", "lockRoute"],
        "properties": {
          "elementId": { "type": "string", "minLength": 1, "maxLength": 240 },
          "status": { "const": "exercised" },
          "contextMenuRoute": { "type": "string", "minLength": 1, "maxLength": 240 },
          "appearanceRoute": { "type": "string", "minLength": 1, "maxLength": 240 },
          "lockRoute": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "visualInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "clippingVerdict", "visualDefectIds"],
      "properties": {
        "method": { "const": "original-image-inspection" },
        "clippingVerdict": { "enum": ["checked-no-defect", "checked-defect"] },
        "visualDefectIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      }
    }
  }
}
